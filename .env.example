# APP_URL: The URL where this app is hosted.
# Used for self-referential links and external API endpoints.
APP_URL="https://trinityverd.com"

# Firebase Configuration (Required for external deployment)
# Rename this file to .env and fill in your values
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Supabase Configuration
# Fill in these values from your Supabase project dashboard (Settings -> API)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Supabase configuration for database connectivity.
VITE_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Taifa Mobile SMS gateway settings.
TAIFA_API_KEY="YOUR_TAIFA_H_API_KEY"
TAIFA_SMS_SENDER="TRIN_VERD"
TAIFA_SMS_SERVER_PORT="3001"

