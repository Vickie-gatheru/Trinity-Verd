# GEMINI_API_KEY: Required for Gemini AI API calls.
# Injected at runtime from user environment secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase configuration for database connectivity.
VITE_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Taifa Mobile SMS gateway settings.
TAIFA_API_KEY="YOUR_TAIFA_H_API_KEY"
TAIFA_SMS_SENDER="TRIN_VERD"
TAIFA_SMS_SERVER_PORT="3001"

